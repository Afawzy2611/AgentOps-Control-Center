# Copy to .env and fill in values. Never commit real secrets.

# Required for AGENT_RUNTIME=agents_sdk (OpenAI Agents SDK live path)
OPENAI_API_KEY=your-openai-api-key-here

# Shared API key for control-center and Launch Desk mutating/export routes
# Accepted via Authorization: Bearer … or X-API-Key
AGENTOPS_API_KEY=replace-with-a-long-random-secret

# Runtime selection: deterministic (default) or agents_sdk
AGENT_RUNTIME=deterministic

# Fail closed even on loopback when set to 1/true (non-loopback HOST always requires a key)
# REQUIRE_AUTH=0

# Bind address; non-loopback requires AGENTOPS_API_KEY
# HOST=127.0.0.1
# PORT=8787

# Optional Launch Desk model override
# LAUNCH_DESK_MODEL=gpt-4.1
